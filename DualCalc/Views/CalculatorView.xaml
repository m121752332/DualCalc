<UserControl
    x:Class="DualCalc.Views.CalculatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DualCalc.Views"
    xmlns:vm="using:DualCalc.ViewModels"
    xmlns:conv="using:DualCalc.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="320">

    <UserControl.Resources>
        <!-- Base button style matching Windows Calculator -->
        <Style x:Key="CalcButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="{x:Bind ViewModel.ButtonFontSize, Mode=OneWay}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="52"/>
        </Style>

        <Style x:Key="FuncButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="FontSize" Value="{x:Bind ViewModel.FuncButtonFontSize, Mode=OneWay}"/>
        </Style>

        <Style x:Key="OpButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}"/>

        <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}"/>

        <Style x:Key="MemButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="{x:Bind ViewModel.MemButtonFontSize, Mode=OneWay}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <!-- Label row (A / B) -->
            <RowDefinition Height="28"/>
            <!-- Expression display -->
            <RowDefinition Height="32"/>
            <!-- Main display -->
            <RowDefinition Height="72"/>
            <!-- Memory row -->
            <RowDefinition Height="36"/>
            <!-- Function row -->
            <RowDefinition Height="*"/>
            <!-- Number pad (5 rows × *) -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Label ── -->
        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.Label}"
                   FontSize="12"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"/>

        <!-- ── Expression ── -->
        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.Expression, Mode=OneWay}"
                   FontSize="13"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,12,0"/>

        <!-- ── Main Display ── -->
        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.Display, Mode=OneWay}"
                   FontSize="40"
                   FontWeight="Light"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,12,0"/>

        <!-- ── Memory Row ── -->
        <Grid Grid.Row="3" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="MC" Style="{StaticResource MemButtonStyle}"
                    Click="OnMemoryClear"
                    IsEnabled="{x:Bind ViewModel.HasMemory, Mode=OneWay}"/>
            <Button Grid.Column="1" Content="MR" Style="{StaticResource MemButtonStyle}"
                    Click="OnMemoryRecall"
                    IsEnabled="{x:Bind ViewModel.HasMemory, Mode=OneWay}"/>
            <Button Grid.Column="2" Content="M+" Style="{StaticResource MemButtonStyle}"
                    Click="OnMemoryAdd"/>
            <Button Grid.Column="3" Content="M−" Style="{StaticResource MemButtonStyle}"
                    Click="OnMemorySubtract"/>
            <Button Grid.Column="4" Content="MS" Style="{StaticResource MemButtonStyle}"
                    Click="OnMemoryStore"/>
        </Grid>

        <!-- ── Function Row: % CE C ⌫ ── -->
        <Grid Grid.Row="4" Margin="4,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="%" Style="{StaticResource FuncButtonStyle}" Click="OnPercent"/>
            <Button Grid.Column="1" Content="CE" Style="{StaticResource FuncButtonStyle}" Click="OnClearEntry"/>
            <Button Grid.Column="2" Content="C"  Style="{StaticResource FuncButtonStyle}" Click="OnClear"/>
            <Button Grid.Column="3" Content="⌫" Style="{StaticResource FuncButtonStyle}" Click="OnBackspace"/>
        </Grid>

        <!-- ── Row 5: 1/x  x²  ²√x  ÷ ── -->
        <Grid Grid.Row="5" Margin="4,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="¹/ₓ"  Style="{StaticResource FuncButtonStyle}" Click="OnReciprocal"/>
            <Button Grid.Column="1" Content="x²"   Style="{StaticResource FuncButtonStyle}" Click="OnSquare"/>
            <Button Grid.Column="2" Content="²√x"  Style="{StaticResource FuncButtonStyle}" Click="OnSquareRoot"/>
            <Button Grid.Column="3" Content="÷"    Style="{StaticResource OpButtonStyle}"   Click="OnOperatorClick" Tag="÷"/>
        </Grid>

        <!-- ── Row 6: 7 8 9 × ── -->
        <Grid Grid.Row="6" Margin="4,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="7" Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="7"/>
            <Button Grid.Column="1" Content="8" Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="8"/>
            <Button Grid.Column="2" Content="9" Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="9"/>
            <Button Grid.Column="3" Content="×" Style="{StaticResource OpButtonStyle}"   Click="OnOperatorClick" Tag="×"/>
        </Grid>

        <!-- ── Row 7: 4 5 6 − ── -->
        <Grid Grid.Row="7" Margin="4,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="4" Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="4"/>
            <Button Grid.Column="1" Content="5" Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="5"/>
            <Button Grid.Column="2" Content="6" Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="6"/>
            <Button Grid.Column="3" Content="−" Style="{StaticResource OpButtonStyle}"   Click="OnOperatorClick" Tag="-"/>
        </Grid>

        <!-- ── Row 8: 1 2 3 + ── -->
        <Grid Grid.Row="8" Margin="4,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="1" Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="1"/>
            <Button Grid.Column="1" Content="2" Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="2"/>
            <Button Grid.Column="2" Content="3" Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="3"/>
            <Button Grid.Column="3" Content="+" Style="{StaticResource OpButtonStyle}"   Click="OnOperatorClick" Tag="+"/>
        </Grid>

        <!-- ── Row 9: +/−  0  .  = ── -->
        <Grid Grid.Row="9" Margin="4,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="+/−" Style="{StaticResource CalcButtonStyle}" Click="OnNegate"/>
            <Button Grid.Column="1" Content="0"   Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="0"/>
            <Button Grid.Column="2" Content="."   Style="{StaticResource CalcButtonStyle}" Click="OnDigitClick" Tag="."/>
            <Button Grid.Column="3" Content="="   Style="{StaticResource EqualsButtonStyle}" Click="OnEquals"/>
        </Grid>
    </Grid>
</UserControl>
