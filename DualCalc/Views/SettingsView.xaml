<Page
    x:Class="DualCalc.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="24" MaxWidth="800">

            <InfoBar IsOpen="{x:Bind ViewModel.HasLocalizationError, Mode=OneWay}"
                     Severity="Warning"
                     Title="語系檔案載入失敗"
                     Message="{x:Bind ViewModel.LocalizationLoadError, Mode=OneWay}" />

            <!-- ── Title ── -->
            <TextBlock Text="{x:Bind ViewModel.Loc.Nav_Settings, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Margin="0,0,0,8" />

            <!-- ── Language ── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE774;" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Loc.Settings_Language, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="12">
                        <RadioButton Content="{x:Bind ViewModel.Loc.Settings_ZhTw, Mode=OneWay}"
                                     IsChecked="{x:Bind ViewModel.IsZhTw, Mode=OneWay}"
                                     Checked="LangRadioButton_Checked"
                                     Tag="ZhTw"
                                     GroupName="LangGroup"/>

                        <RadioButton Content="{x:Bind ViewModel.Loc.Settings_ZhCn, Mode=OneWay}"
                                     IsChecked="{x:Bind ViewModel.IsZhCn, Mode=OneWay}"
                                     Checked="LangRadioButton_Checked"
                                     Tag="ZhCn"
                                     GroupName="LangGroup"/>

                        <RadioButton Content="{x:Bind ViewModel.Loc.Settings_EnUs, Mode=OneWay}"
                                     IsChecked="{x:Bind ViewModel.IsEnUs, Mode=OneWay}"
                                     Checked="LangRadioButton_Checked"
                                     Tag="EnUs"
                                     GroupName="LangGroup"/>

                        <RadioButton Content="{x:Bind ViewModel.Loc.Settings_JaJp, Mode=OneWay}"
                                     IsChecked="{x:Bind ViewModel.IsJaJp, Mode=OneWay}"
                                     Checked="LangRadioButton_Checked"
                                     Tag="JaJp"
                                     GroupName="LangGroup"/>
                    </StackPanel>
                </Expander.Content>
            </Expander>

            <!-- ── Theme ── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Loc.Settings_Theme, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="12">
                        <RadioButton Content="{x:Bind ViewModel.Loc.Settings_ThemeLight, Mode=OneWay}"
                                     IsChecked="{x:Bind ViewModel.IsThemeLight, Mode=OneWay}"
                                     Checked="ThemeRadioButton_Checked"
                                     Tag="Light"
                                     GroupName="ThemeGroup"/>

                        <RadioButton Content="{x:Bind ViewModel.Loc.Settings_ThemeDark, Mode=OneWay}"
                                     IsChecked="{x:Bind ViewModel.IsThemeDark, Mode=OneWay}"
                                     Checked="ThemeRadioButton_Checked"
                                     Tag="Dark"
                                     GroupName="ThemeGroup"/>

                        <RadioButton Content="{x:Bind ViewModel.Loc.Settings_ThemeSystem, Mode=OneWay}"
                                     IsChecked="{x:Bind ViewModel.IsThemeSystem, Mode=OneWay}"
                                     Checked="ThemeRadioButton_Checked"
                                     Tag="System"
                                     GroupName="ThemeGroup"/>
                    </StackPanel>
                </Expander.Content>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
